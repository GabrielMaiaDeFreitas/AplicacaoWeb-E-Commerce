<h2><%= @produto.nome %></h2>

<p>

    <strong>Preço:</strong>

    R$ <%= format("%.2f", @produto.preco) %>

</p>

<p>

    <strong>Estoque:</strong>

    <%= @produto.estoque %>

</p>

<p>

    <strong>Vendedor:</strong>

    <%= @produto.vendedor.nome %>

</p>

<% if @produto.descricao && !@produto.descricao.empty? %>

    <p>

        <strong>Descrição:</strong>

        <%= @produto.descricao %>

    </p>

<% end %>

<hr>

<p>

    <a href="/catalogo">

        Voltar ao catálogo

    </a>

</p>

<p>
    <a href="/carrinho">

        Ver Carrinho

    </a>

</p>

<p>

    <form class="inline" action="/carrinho/adicionar/<%= @produto.id %>"method="post">

        <button type="submit">

            Adicionar ao Carrinho

        </button>

    </form>

</p>