<h2>Cadastro de Usuário</h2>

<% if @usuario.errors.any? %>

<div class="erros">

    <h3>Ocorreram erros:</h3>

    <ul>

        <% @usuario.errors.full_messages.each do |erro| %>

            <li><%= erro %></li>

        <% end %>

    </ul>

</div>

<% end %>

<form action="/usuarios" method="post">

    <label>Nome</label><br>
    <input type="text" name="nome" value="<%= @usuario.nome %>"><br><br>

    <label>Email</label><br>
    <input type="email" name="email" value="<%= @usuario.email %>"><br><br>

    <label>Senha</label><br>
    <input type="password" name="senha"><br><br>

    <label>CPF</label><br>
    <input type="text" name="cpf" value="<%= @usuario.cpf %>"><br><br>

    <label>Telefone</label><br>
    <input type="text" name="telefone" value="<%= @usuario.telefone %>"><br><br>

    <button type="submit">
        Cadastrar
    </button>

</form>