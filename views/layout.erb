<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sistema de E-commerce</title>

    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

<header>
    <h1>Sistema de E-commerce</h1>

    <nav>

        <a href="/">Início</a>

        |

        <% if logado? %>

            <a href="/catalogo">Catálogo</a>

            |

            <a href="/carrinho">Carrinho</a>

            |

            <a href="/compras">Minhas Compras</a>

            |

            <a href="/vendas"> Minhas Vendas</a>

            |

            <a href="/produtos">Meus Produtos</a>

            |

            <a href="/produtos/new">Novo Produto</a>

            |

            <a href="/perfil">Meu Perfil</a>

            |

            <a href="/logout">Sair</a>
            
        <% else %>

            <a href="/usuarios/new">Cadastrar</a>

            |

            <a href="/login">Login</a>

        <% end %>

    </nav>

    <hr>
</header>

<main>

    <% if session[:sucesso] %>
        <div class="mensagem sucesso">
            <%= session.delete(:sucesso) %>
        </div>
    <% end %>

    <% if session[:erro] %>
        <div class="mensagem erro">
            <%= session.delete(:erro) %>
        </div>
    <% end %>

    <%= yield %>

</main>

<footer>

    <hr>

    <p>
        Programação Web — IFG
    </p>

</footer>

</body>
</html>